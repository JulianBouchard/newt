  { x: 838, y: 419, text: "5", size: 19, tone: "accent", weight: 700 },

  { x: 930, y: 128, text: ["prefix + history are cached:", "each turn pays only for", "what is new"], size: 21, tone: "accent" },
  { x: 862, y: 420, text: ["end of turn: reads dropped,", "writes kept as one-line", "summaries"], size: 21, tone: "accent" },
  { x: 40, y: 590, text: ["complete_task marks tasks.md stale.", "The next read refetches it,", "like React Query."], size: 21, tone: "accent" },
  { x: 804, y: 612, text: ["send_message is journaled here first,", "so it goes out once, even after a crash"], size: 20, tone: "accent" },
  { x: 150, y: 700, text: "any newt instance can run any session", size: 20, tone: "accent" },
