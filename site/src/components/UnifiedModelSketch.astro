---
import { UNIFIED_MODEL_DESCRIPTION } from "./sketch-descriptions";
import { ACCENT, createSketch, type SketchLabel } from "./rough-sketch";
import SketchCanvas from "./SketchCanvas.astro";

const sketch = createSketch(311);
const { box, arrow } = sketch;

box(50, 80, 300, 150);
box(450, 80, 300, 150);
box(850, 80, 300, 150, { stroke: ACCENT, strokeWidth: 2.2 });
box(880, 160, 150, 36, { stroke: ACCENT, strokeWidth: 2 });

box(36, 300, 352, 170, {}, true);
box(424, 300, 352, 170, {}, true);
box(812, 300, 352, 170, { stroke: ACCENT }, true);
box(82, 318, 260, 50);
box(470, 318, 260, 50);
box(858, 318, 260, 50, { stroke: ACCENT, strokeWidth: 2 });

box(80, 540, 1040, 116, { fill: "var(--sk-fill-soft)", fillStyle: "hachure", hachureGap: 12, fillWeight: 1 });

arrow([[170, 232], [170, 316]]);
arrow([[250, 232], [400, 270], [540, 316]]);
arrow([[560, 232], [420, 270], [290, 316]]);
arrow([[640, 232], [640, 316]]);
arrow([[1000, 232], [1000, 316]], ACCENT);
arrow([[212, 472], [212, 538]]);
arrow([[600, 472], [600, 538]]);
arrow([[988, 472], [988, 538]], ACCENT);

arrow([[80, 630], [22, 440], [46, 200]], ACCENT);
arrow([[1120, 630], [1178, 440], [1150, 200], [1034, 178]], ACCENT);

const labels: SketchLabel[] = [
  { x: 72, y: 124, text: "frontend", size: 30, weight: 700 },
  { x: 72, y: 160, text: "pages and the app", size: 20, tone: "muted" },
  { x: 72, y: 200, text: "query key: tasks", size: 20 },

  { x: 472, y: 124, text: "other agents", size: 30, weight: 700 },
  { x: 472, y: 160, text: "Claude, ChatGPT, …", size: 20, tone: "muted" },
  { x: 472, y: 200, text: "anonymous, or as the user", size: 20 },

  { x: 872, y: 124, text: "newt", size: 30, tone: "accent", weight: 700 },
  { x: 950, y: 122, text: "your agent", size: 20, tone: "muted" },
  { x: 896, y: 185, text: "tasks.md", size: 20, tone: "accent", weight: 600 },
  { x: 884, y: 220, text: "a workspace page", size: 17, tone: "muted" },

  { x: 212, y: 350, text: "routes · MCP", size: 21, weight: 600, anchor: "middle" },
  { x: 600, y: 350, text: "routes · MCP", size: 21, weight: 600, anchor: "middle" },
  { x: 988, y: 350, text: "admin routes · home MCP", size: 21, tone: "accent", weight: 600, anchor: "middle" },
  { x: 212, y: 412, text: "public", size: 23, weight: 700, anchor: "middle" },
  { x: 212, y: 440, text: "anyone browsing", size: 18, tone: "muted", anchor: "middle" },
  { x: 600, y: 412, text: "authenticated", size: 23, weight: 700, anchor: "middle" },
  { x: 600, y: 440, text: "a logged-in user", size: 18, tone: "muted", anchor: "middle" },
  { x: 988, y: 412, text: "private", size: 23, tone: "accent", weight: 700, anchor: "middle" },
  { x: 988, y: 440, text: "an admin, or your backend", size: 18, tone: "muted", anchor: "middle" },

  { x: 1016, y: 272, text: "call tool", size: 19 },

  { x: 600, y: 588, text: "your core API", size: 30, weight: 700, anchor: "middle" },
  { x: 600, y: 624, text: "complete_task(7): done, and the key tasks changed", size: 21, anchor: "middle" },

  { x: 30, y: 698, text: ["the UI refetches tasks", "in the background"], size: 21, tone: "accent" },
  { x: 900, y: 698, text: ["tasks.md goes stale,", "the agent reads it again"], size: 21, tone: "accent" },
  { x: 600, y: 720, text: "one API · one way to say what changed", size: 21, tone: "accent", anchor: "middle" },
];
---

<SketchCanvas
  viewBox="0 60 1200 710"
  strokes={sketch.strokes}
  labels={labels}
  description={UNIFIED_MODEL_DESCRIPTION}
  captionId="newt-unified-caption"
/>
