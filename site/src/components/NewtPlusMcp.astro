---
import markSvg from "../assets/generated/mark.svg?raw";
import { NEWT_PLUS_MCP_DESCRIPTION } from "./sketch-descriptions";
import { ACCENT, createSketch, type SketchLabel } from "./rough-sketch";
import SketchCanvas from "./SketchCanvas.astro";

const sketch = createSketch(101);
const { box, line, circle, path } = sketch;

circle(95, 105, 150, { stroke: ACCENT, strokeWidth: 1.8 });

line(196, 104, 236, 102, { strokeWidth: 2.4 });
line(215, 84, 217, 124, { strokeWidth: 2.4 });

box(262, 38, 212, 140);
line(278, 76, 458, 75, { roughness: 0.7, strokeWidth: 1 });
for (const y of [100, 128, 156]) {
  path(`M 282 ${y - 6} l 5 6 l 9 -12`, { stroke: ACCENT, strokeWidth: 1.8, roughness: 0.5 });
}

line(500, 94, 540, 93, { strokeWidth: 2.4 });
line(500, 112, 540, 111, { strokeWidth: 2.4 });

path("M 590 42 Q 570 42 570 62 L 570 142 Q 570 162 590 162 L 612 162 L 596 196 L 642 162 L 778 162 Q 798 162 798 142 L 798 62 Q 798 42 778 42 Z", {
  stroke: ACCENT,
  strokeWidth: 2,
  fill: "var(--sk-fill-soft)",
  fillStyle: "hachure",
  hachureGap: 11,
  fillWeight: 1,
});

const labels: SketchLabel[] = [
  { x: 95, y: 214, text: "newt", size: 28, tone: "accent", weight: 700, anchor: "middle" },
  { x: 278, y: 66, text: "your MCP server", size: 24, weight: 700 },
  { x: 304, y: 102, text: "instructions", size: 20 },
  { x: 304, y: 130, text: "tools", size: 20 },
  { x: 304, y: 158, text: "resources", size: 20 },
  { x: 684, y: 108, text: "an agent", size: 40, weight: 700, anchor: "middle" },
  { x: 684, y: 140, text: "ready for events", size: 20, tone: "muted", anchor: "middle" },
];

const mark = markSvg
  .replace(/\sid="([^"]+)"/g, ' id="plus-$1"')
  .replace(/url\(#([^)]+)\)/g, "url(#plus-$1)")
  .replace("<svg ", '<svg x="35" y="45" width="120" height="120" ');
---

<SketchCanvas
  class="newt-sketch-equation"
  viewBox="0 20 820 205"
  strokes={sketch.strokes}
  labels={labels}
  description={NEWT_PLUS_MCP_DESCRIPTION}
  captionId="newt-plus-mcp-caption"
  minWidth="30rem"
>
  <g set:html={mark} />
</SketchCanvas>
