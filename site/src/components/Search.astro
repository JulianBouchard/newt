---
import Default from "@astrojs/starlight/components/Search.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const page = (path: string) => `${base}/${path}`;

const groups = [
  {
    label: "Start here",
    items: [
      { title: "Quickstart", hint: "Run the demo with Docker and no API key", href: page("quickstart/") },
      { title: "How a turn works", hint: "From event to commit, step by step", href: page("how-a-turn-works/") },
      { title: "Context provider", hint: "The three endpoints your app serves", href: page("context-provider/") },
      { title: "Tools over MCP", hint: "Retention, invalidation, exactly-once calls", href: page("tools/") },
    ],
  },
  {
    label: "Look up",
    items: [
      { title: "Configuration", hint: "Every server.toml key and its default", href: page("configuration/") },
      { title: "Protocol", hint: "The full contract, field by field", href: page("protocol/") },
      { title: "Sending events", hint: "Event API and live feed", href: page("events/") },
      { title: "Changelog", hint: "What changed in each release", href: page("changelog/") },
    ],
  },
  {
    label: "For LLMs",
    items: [
      { title: "This page as Markdown", hint: "Clean text of the page you are on", href: page("index.md"), currentPageMarkdown: true },
      { title: "llms.txt", hint: "Index of every page", href: page("llms.txt") },
      { title: "llms-full.txt", hint: "All of the docs in one file", href: page("llms-full.txt") },
    ],
  },
];
---

<Default {...Astro.props} />

<template id="newt-search-suggestions">
  <nav class="newt-suggest" aria-label="Suggested pages">
    {
      groups.map((group) => (
        <section>
          <h2>{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} data-current-page-markdown={item.currentPageMarkdown ? "" : undefined}>
                  <span class="newt-suggest-title">{item.title}</span>
                  <span class="newt-suggest-hint">{item.hint}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
</template>

<script>
  const template = document.querySelector<HTMLTemplateElement>("#newt-search-suggestions");
  const container = document.querySelector("site-search .search-container");
  if (template && container) {
    container.append(template.content.cloneNode(true));
    const markdownLink = container.querySelector<HTMLAnchorElement>("[data-current-page-markdown]");
    if (markdownLink) {
      const path = location.pathname.replace(/\/$/, "");
      const base = import.meta.env.BASE_URL.replace(/\/$/, "");
      markdownLink.href = path === base ? `${base}/index.md` : `${path}.md`;
    }
  }
</script>
