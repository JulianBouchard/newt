---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { Icon } from "@astrojs/starlight/components";

const { entry } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const markdownPath = `${base}/${entry.id}.md`;
const markdownUrl = new URL(markdownPath, Astro.site).href;
const prompt = `Read ${markdownUrl} (the newt docs page "${entry.data.title}") so you can answer my questions about it.`;
const showActions = entry.id !== "404";
---

<Default />
{
  showActions && (
    <div class="newt-page-actions" role="group" aria-label="Use this page">
      <button type="button" data-copy-markdown={markdownPath}>
        <Icon name="document" size="0.95em" />
        <span data-label>Copy as Markdown</span>
      </button>
      <a href={markdownPath}>View .md</a>
      <a href={`https://claude.ai/new?q=${encodeURIComponent(prompt)}`} target="_blank" rel="noopener">
        Ask Claude <Icon name="external" size="0.8em" />
      </a>
      <a href={`https://chatgpt.com/?q=${encodeURIComponent(prompt)}`} target="_blank" rel="noopener">
        Ask ChatGPT <Icon name="external" size="0.8em" />
      </a>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-markdown]").forEach((button) => {
    const label = button.querySelector<HTMLElement>("[data-label]");
    button.addEventListener("click", async () => {
      const response = await fetch(button.dataset.copyMarkdown!);
      await navigator.clipboard.writeText(await response.text());
      if (!label) return;
      label.textContent = "Copied";
      setTimeout(() => (label.textContent = "Copy as Markdown"), 1600);
    });
  });
</script>
